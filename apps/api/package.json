{
  "name": "@dnsoil/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "migrate": "tsx src/migrate.ts",
    "test:wallet-ledger": "tsx src/wallet-ledger-smoke.ts",
    "test:hosting": "tsx src/hosting-smoke.ts",
    "test:catalog": "tsx src/catalog-smoke.ts"
  },
  "dependencies": {
    "@dnsoil/shared": "workspace:*",
    "fastify": "^5.12.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
