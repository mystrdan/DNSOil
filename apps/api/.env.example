# Local development only. Never commit real credentials.
HOST=0.0.0.0
PORT=4000
# Optional: when set, GET /ready verifies PostgreSQL connectivity.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# Shared secret for trusted server-to-server Google user provisioning.
# Generate a long random value and configure the same value in the web app.
DNSOIL_INTERNAL_API_SECRET=

# Shared HS256 signing key for short-lived, user-scoped API access tokens.
# Keep this separate from DNSOIL_INTERNAL_API_SECRET.
DNSOIL_API_TOKEN_SECRET=
