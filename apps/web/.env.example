# Auth.js session encryption secret: generate with npx auth secret
AUTH_SECRET=
# Google Cloud OAuth 2.0 Web Client credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Authorized callback URI for local development:
# http://localhost:3000/api/auth/callback/google

# Optional server-to-server user provisioning. Configure both values to enable it.
# If enabled, Google sign-in fails closed when provisioning fails.
DNSOIL_API_URL=http://localhost:4000
DNSOIL_INTERNAL_API_SECRET=

# Separate signing key for 5-minute user-scoped API access tokens.
# Configure the same value in the API and web server environments.
DNSOIL_API_TOKEN_SECRET=
